# Copy to .env.local (gitignored). Vite exposes only VITE_* variables to the app; never put secrets here.
# local | demo | staging | prod. Non-local environments need Firebase anonymous sign-in (issue #23).
VITE_APP_ENV=local
# Shows the "SIMULASI" band; refused with VITE_APP_ENV=prod. Match the ingestion service's DEMO_MODE.
VITE_DEMO_MODE=true
VITE_INGESTION_URL=http://localhost:8001
# case-audit: the audit questions put to the reporter (SCR-006).
VITE_CASE_AUDIT_URL=http://localhost:8002
VITE_DOMAIN=mbg
