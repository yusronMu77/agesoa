[project]
name = "agesoa-{{ service_name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.13,<3.14"
dependencies = [
  "agesoa-platform",
  "agesoa-contracts",
{%- if with_agent %}
  "agesoa-packs",
  "google-adk~=2.11.0",
{%- endif %}
]

[build-system]
requires = ["hatchling~=1.27"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
