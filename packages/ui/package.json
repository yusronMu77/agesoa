{
  "name": "@agesoa/ui",
  "version": "0.4.0",
  "private": true,
  "description": "Shared UI of the AGESOA apps: design tokens as CSS custom properties, fonts, the shadcn theme and the React components used by both apps.",
  "files": [
    "tokens.css",
    "fonts.css",
    "theme.css",
    "penpot-theme.css",
    "src"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./theme.css": "./theme.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./assets/*": "./src/assets/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:tokens": "bun scripts/build-tokens.ts",
    "check:theme": "bun scripts/check-theme.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/saira": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "tailwind-merge": "^3.7.0"
  },
  "type": "module",
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9"
  }
}
