{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agesoa:schema:event:follow_up.updated:v1",
  "title": "Follow-up updated",
  "allOf": [
    {
      "$ref": "urn:agesoa:schema:cloudevent:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "agesoa.follow_up.updated"
    },
    "dataschema": {
      "const": "urn:agesoa:schema:event:follow_up.updated:v1"
    },
    "data": {
      "type": "object",
      "required": [
        "case_id",
        "organization_id",
        "status",
        "note",
        "internal_ticket",
        "updated_at",
        "synthetic"
      ],
      "properties": {
        "case_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "organization_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "status": {
          "enum": [
            "received",
            "in_progress",
            "done"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Optional short status detail in the institution's own words (one line, e.g. \"Re-inspection scheduled\"). Shown publicly next to the finding, labelled as the institution's statement, never edited. Added in v1 as an optional field (not breaking)."
        },
        "note": {
          "type": "string"
        },
        "internal_ticket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated_at": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/timestamp"
        },
        "synthetic": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/synthetic"
        }
      },
      "additionalProperties": false
    }
  }
}
