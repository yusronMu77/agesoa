{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agesoa:schema:event:sinyal.diterima:v1",
  "title": "Public signal received",
  "allOf": [
    {
      "$ref": "urn:agesoa:schema:cloudevent:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "agesoa.sinyal.diterima"
    },
    "dataschema": {
      "const": "urn:agesoa:schema:event:sinyal.diterima:v1"
    },
    "data": {
      "type": "object",
      "required": [
        "signal_id",
        "domain",
        "category",
        "occurred_on",
        "region",
        "summary",
        "sources",
        "dedup_key",
        "synthetic"
      ],
      "properties": {
        "signal_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "occurred_on": {
          "type": "string",
          "format": "date"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/region"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "publisher",
              "kind",
              "published_at"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "news",
                  "official",
                  "social_shared"
                ]
              },
              "published_at": {
                "anyOf": [
                  {
                    "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "dedup_key": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/synthetic"
        }
      },
      "additionalProperties": false
    }
  }
}
