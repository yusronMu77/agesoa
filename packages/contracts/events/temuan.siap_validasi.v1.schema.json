{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agesoa:schema:event:temuan.siap_validasi:v1",
  "title": "Finding ready for validation",
  "allOf": [
    {
      "$ref": "urn:agesoa:schema:cloudevent:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "agesoa.temuan.siap_validasi"
    },
    "dataschema": {
      "const": "urn:agesoa:schema:event:temuan.siap_validasi:v1"
    },
    "data": {
      "type": "object",
      "required": [
        "finding_id",
        "case_id",
        "domain",
        "statement",
        "status",
        "evidence_refs",
        "required_roles",
        "parties_mentioned",
        "region",
        "synthetic"
      ],
      "properties": {
        "finding_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "case_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/finding_status"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/evidence_ref"
          },
          "minItems": 1
        },
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Validator roles from the domain pack's validator_roles."
        },
        "parties_mentioned": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Organizations named in the case; validators from these are not routed (conflict of interest)."
        },
        "region": {
          "anyOf": [
            {
              "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/region"
            },
            {
              "type": "null"
            }
          ]
        },
        "synthetic": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/synthetic"
        }
      },
      "additionalProperties": false
    }
  }
}
