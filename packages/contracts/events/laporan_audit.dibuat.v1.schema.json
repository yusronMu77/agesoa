{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agesoa:schema:event:laporan_audit.dibuat:v1",
  "title": "Audit report created",
  "allOf": [
    {
      "$ref": "urn:agesoa:schema:cloudevent:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "agesoa.laporan_audit.dibuat"
    },
    "dataschema": {
      "const": "urn:agesoa:schema:event:laporan_audit.dibuat:v1"
    },
    "data": {
      "type": "object",
      "required": [
        "audit_report_id",
        "case_id",
        "domain",
        "summary",
        "root_causes",
        "recommendations",
        "region",
        "created_at",
        "synthetic"
      ],
      "properties": {
        "audit_report_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "case_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "root_causes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "statement",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/finding_status"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/evidence_ref"
                }
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "region": {
          "anyOf": [
            {
              "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/region"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/timestamp"
        },
        "synthetic": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/synthetic"
        }
      },
      "additionalProperties": false
    }
  }
}
