{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agesoa:schema:event:organisasi.terverifikasi:v1",
  "title": "Organization verified",
  "allOf": [
    {
      "$ref": "urn:agesoa:schema:cloudevent:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "agesoa.organisasi.terverifikasi"
    },
    "dataschema": {
      "const": "urn:agesoa:schema:event:organisasi.terverifikasi:v1"
    },
    "data": {
      "type": "object",
      "required": [
        "organization_id",
        "name",
        "kind",
        "domain",
        "method",
        "verified_at",
        "synthetic"
      ],
      "properties": {
        "organization_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "newsroom",
            "agency"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "dns_txt",
            "well_known",
            "seed"
          ]
        },
        "verified_at": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/timestamp"
        },
        "synthetic": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/synthetic"
        }
      },
      "additionalProperties": false
    }
  }
}
