{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agesoa:schema:event:validasi.selesai:v1",
  "title": "Validation completed",
  "allOf": [
    {
      "$ref": "urn:agesoa:schema:cloudevent:v1"
    }
  ],
  "properties": {
    "type": {
      "const": "agesoa.validasi.selesai"
    },
    "dataschema": {
      "const": "urn:agesoa:schema:event:validasi.selesai:v1"
    },
    "data": {
      "type": "object",
      "required": [
        "finding_id",
        "case_id",
        "outcome",
        "decisions",
        "completed_at",
        "synthetic"
      ],
      "properties": {
        "finding_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "case_id": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
        },
        "outcome": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validator_ref",
              "organization_ref",
              "tier",
              "decision"
            ],
            "properties": {
              "validator_ref": {
                "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
              },
              "organization_ref": {
                "anyOf": [
                  {
                    "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tier": {
                "enum": [
                  "high",
                  "medium"
                ]
              },
              "decision": {
                "enum": [
                  "approve",
                  "reject"
                ]
              },
              "note": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "description": "Validator role id from the domain pack's validator_roles."
              },
              "role_label": {
                "type": "string",
                "description": "English label of the role, shown publicly instead of any name."
              },
              "regency_name": {
                "type": ["string", "null"],
                "description": "Regency the validator works in (public label next to the role)."
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "completed_at": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/timestamp"
        },
        "synthetic": {
          "$ref": "urn:agesoa:schema:cloudevent:v1#/$defs/synthetic"
        }
      },
      "additionalProperties": false
    }
  }
}
