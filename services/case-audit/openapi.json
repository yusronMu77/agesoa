{
  "openapi": "3.1.0",
  "info": {
    "title": "AGESOA case-audit",
    "description": "Cases, evidence deadlines, witness interviews, audit trail and findings; agent Audit.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness (no dependencies)",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: own database reachable",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/internal/outbox/sweep": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Publish outbox events left behind (Cloud Scheduler, every minute)",
        "operationId": "sweep_internal_outbox_sweep_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SweepResult"
                }
              }
            }
          }
        }
      }
    },
    "/internal/demo/reset": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Empty this service's database and seed its demo data again (demo_mode only)",
        "operationId": "demo_reset_internal_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned when demo_mode is off)"
          }
        }
      }
    },
    "/internal/probe": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Record a system probe decision through the outbox (end-to-end event path check)",
        "operationId": "probe_internal_probe_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ops/events": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Event traffic of this service (operator; counts and types, no payloads)",
        "operationId": "events_v1_ops_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsEvents"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ops/demo-reset": {
      "post": {
        "tags": [
          "ops"
        ],
        "summary": "Operator: empty this service's database and seed its demo data again (demo_mode only)",
        "operationId": "operator_demo_reset_v1_ops_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned when demo_mode is off)"
          }
        }
      }
    },
    "/v1/cases": {
      "get": {
        "tags": [
          "cases"
        ],
        "summary": "Cases, newest first",
        "operationId": "list_cases_v1_cases_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Case"
                  },
                  "title": "Response List Cases V1 Cases Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{case_id}": {
      "get": {
        "tags": [
          "cases"
        ],
        "summary": "One case with its findings",
        "operationId": "get_case_v1_cases__case_id__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetail"
                }
              }
            }
          },
          "404": {
            "description": "Unknown case"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{case_id}/audit-trail": {
      "get": {
        "tags": [
          "cases"
        ],
        "summary": "Every audit step with its evidence status, oldest first",
        "operationId": "get_audit_trail_v1_cases__case_id__audit_trail_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditStep"
                  },
                  "title": "Response Get Audit Trail V1 Cases  Case Id  Audit Trail Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/witness/questions": {
      "get": {
        "tags": [
          "cases",
          "witness"
        ],
        "summary": "Audit questions waiting for me, as the reporter of a report of the case",
        "operationId": "my_questions_v1_witness_questions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WitnessQuestion"
                  },
                  "type": "array",
                  "title": "Response My Questions V1 Witness Questions Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{case_id}/witness-answers": {
      "post": {
        "tags": [
          "cases",
          "witness"
        ],
        "summary": "A witness (the reporter) answers an audit question",
        "operationId": "answer_question_v1_cases__case_id__witness_answers_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WitnessAnswer"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditStep"
                }
              }
            }
          },
          "404": {
            "description": "No such question for this reporter"
          },
          "409": {
            "description": "The question already has an answer"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditStep": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "step": {
            "type": "string",
            "enum": [
              "hypothesis",
              "question",
              "answer",
              "pattern_test",
              "conclusion"
            ],
            "title": "Step"
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Branch"
          },
          "content": {
            "additionalProperties": true,
            "type": "object",
            "title": "Content"
          },
          "status_label": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "alleged",
                  "supported",
                  "proven"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Label"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Refs"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "step",
          "branch",
          "content",
          "status_label",
          "evidence_refs",
          "actor",
          "created_at"
        ],
        "title": "AuditStep"
      },
      "Case": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "investigating",
              "awaiting_validation",
              "final",
              "closed"
            ],
            "title": "Status"
          },
          "region": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "available",
              "likely_lost",
              "unknown"
            ],
            "title": "Evidence Status"
          },
          "evidence_deadline_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Deadline At"
          },
          "max_finding_status": {
            "type": "string",
            "enum": [
              "alleged",
              "supported",
              "proven"
            ],
            "title": "Max Finding Status"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "domain",
          "category",
          "status",
          "region",
          "evidence_status",
          "evidence_deadline_at",
          "max_finding_status",
          "synthetic",
          "created_at",
          "updated_at"
        ],
        "title": "Case"
      },
      "CaseDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "investigating",
              "awaiting_validation",
              "final",
              "closed"
            ],
            "title": "Status"
          },
          "region": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "available",
              "likely_lost",
              "unknown"
            ],
            "title": "Evidence Status"
          },
          "evidence_deadline_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Deadline At"
          },
          "max_finding_status": {
            "type": "string",
            "enum": [
              "alleged",
              "supported",
              "proven"
            ],
            "title": "Max Finding Status"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          }
        },
        "type": "object",
        "required": [
          "id",
          "domain",
          "category",
          "status",
          "region",
          "evidence_status",
          "evidence_deadline_at",
          "max_finding_status",
          "synthetic",
          "created_at",
          "updated_at",
          "findings"
        ],
        "title": "CaseDetail"
      },
      "DatabaseStatus": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
