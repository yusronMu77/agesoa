      },
      "Readiness": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "release": {
            "type": "string",
            "title": "Release"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
