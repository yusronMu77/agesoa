# Local run (copy to .env, gitignored). Database URL: agesoa-devenv/outputs/local-endpoints.env
# (DATABASE_URL_CASE_AUDIT, with the scheme changed to postgresql+asyncpg://).
ENVIRONMENT=local
DEMO_MODE=false
DATABASE_URL=postgresql+asyncpg://case_audit:CHANGE_ME@10.90.102.204:5432/case_audit
GOOGLE_CLOUD_PROJECT=agesoa-local
PUBSUB_EMULATOR_HOST=10.90.102.204:8085
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Model of Agen Audit: a Gemini model id, or `rules` (the lexical ranking written as a model response).
# (a Gemini model needs GOOGLE_API_KEY, or GOOGLE_GENAI_USE_VERTEXAI=true + Vertex credentials).
AUDIT_MODEL=rules

# Where pattern tests read the incidents of other cases: `database` (this service's own, default) or `bigquery`
# (the event archive agesoa_events.events, with the database as the fallback). Needs GCP credentials.
INCIDENT_STORE=database
# BIGQUERY_EVENTS_TABLE=project.agesoa_events.events
