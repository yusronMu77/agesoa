{
  "openapi": "3.1.0",
  "info": {
    "title": "AGESOA trust",
    "description": "Organizations, validators, staff confirmation, validation routing and quorum; agent Role.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness (no dependencies)",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: own database reachable",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/internal/outbox/sweep": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Publish outbox events left behind (Cloud Scheduler, every minute)",
        "operationId": "sweep_internal_outbox_sweep_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SweepResult"
                }
              }
            }
          }
        }
      }
    },
    "/internal/demo/reset": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Empty this service's database and seed its demo data again (demo_mode only)",
        "operationId": "demo_reset_internal_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned when demo_mode is off)"
          }
        }
      }
    },
    "/internal/probe": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Record a system probe decision through the outbox (end-to-end event path check)",
        "operationId": "probe_internal_probe_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ops/events": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Event traffic of this service (operator; counts and types, no payloads)",
        "operationId": "events_v1_ops_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsEvents"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ops/demo-reset": {
      "post": {
        "tags": [
          "ops"
        ],
        "summary": "Operator: empty this service's database and seed its demo data again (demo_mode only)",
        "operationId": "operator_demo_reset_v1_ops_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned when demo_mode is off)"
          }
        }
      }
    },
    "/v1/validators/me": {
      "get": {
        "tags": [
          "validation",
          "validators"
        ],
        "summary": "The signed-in validator's own profile (role label, tier, status; no personal data)",
        "operationId": "my_profile_v1_validators_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatorProfile"
                }
              }
            }
          },
          "403": {
            "description": "Not a registered validator"
          }
        }
      }
    },
    "/v1/validation-requests": {
      "get": {
        "tags": [
          "validation"
        ],
        "summary": "Findings waiting for validation that are routed to me (role, regency, no conflict)",
        "operationId": "list_requests_v1_validation_requests_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ValidationRequest"
                  },
                  "type": "array",
                  "title": "Response List Requests V1 Validation Requests Get"
                }
              }
            }
          },
          "403": {
            "description": "Not an active validator"
          }
        }
      }
    },
    "/v1/validation-requests/{finding_id}": {
      "get": {
        "tags": [
          "validation"
        ],
        "summary": "One finding with its quorum status",
        "operationId": "get_request_v1_validation_requests__finding_id__get",
        "parameters": [
          {
            "name": "finding_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Finding Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such finding"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/validation-requests/{finding_id}/decisions": {
      "post": {
        "tags": [
          "validation"
        ],
        "summary": "Approve or reject a finding; quorum is evaluated by code",
        "operationId": "decide_v1_validation_requests__finding_id__decisions_post",
        "parameters": [
          {
            "name": "finding_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Finding Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionOut"
                }
              }
            }
          },
          "404": {
            "description": "No such finding"
          },
          "403": {
            "description": "Not an active validator"
          },
          "409": {
            "description": "Already decided, validation closed, or conflict of interest"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/organizations": {
      "get": {
        "tags": [
          "organizations"
        ],
        "summary": "My organizations",
        "operationId": "mine_v1_organizations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Organization"
                  },
                  "type": "array",
                  "title": "Response Mine V1 Organizations Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "organizations"
        ],
        "summary": "Register an organization; returns the TXT record to publish",
        "operationId": "register_v1_organizations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganizationIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "409": {
            "description": "Domain already registered"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/organizations/{organization_id}": {
      "get": {
        "tags": [
          "organizations"
        ],
        "summary": "One of my organizations",
        "operationId": "one_v1_organizations__organization_id__get",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Organization"
                }
              }
            }
          },
          "404": {
            "description": "No such organization of yours"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organization_id}/dns-check": {
      "post": {
        "tags": [
          "organizations"
        ],
        "summary": "Look up the TXT record and verify the organization",
        "operationId": "dns_check_v1_organizations__organization_id__dns_check_post",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DnsCheck"
                }
              }
            }
          },
          "404": {
            "description": "No such organization of yours"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DatabaseStatus": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "DatabaseStatus"
      },
      "DecisionIn": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 4000,
            "title": "Note",
            "default": ""
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "conflict": {
            "type": "boolean",
            "title": "Conflict",
            "description": "Declared conflict of interest: the decision is recorded but not counted.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionIn"
      },
      "DecisionOut": {
        "properties": {
          "finding_id": {
            "type": "string",
            "title": "Finding Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "counted": {
            "type": "boolean",
            "title": "Counted"
          },
          "quorum_reached": {
            "type": "boolean",
            "title": "Quorum Reached"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "quorum": {
            "$ref": "#/components/schemas/QuorumStatus"
          }
        },
        "type": "object",
        "required": [
          "finding_id",
          "decision",
          "counted",
          "quorum_reached",
          "outcome",
          "quorum"
        ],
        "title": "DecisionOut"
      },
      "DnsCheck": {
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "verified",
              "already_verified",
              "no_record",
              "token_mismatch",
              "dns_error"
            ],
            "title": "Result"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          }
        },
        "type": "object",
        "required": [
          "result",
          "detail",
          "organization"
        ],
        "title": "DnsCheck"
      },
      "EventTypeCount": {
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "out",
              "in"
            ],
            "title": "Direction"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "last_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last At"
          }
        },
        "type": "object",
        "required": [
          "direction",
          "event_type",
          "count",
          "last_at"
        ],
        "title": "EventTypeCount"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "release": {
            "type": "string",
            "title": "Release"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode"
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "release",
          "environment",
          "demo_mode"
        ],
        "title": "Health"
      },
      "OpsEvents": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "outbox_pending": {
            "type": "integer",
            "title": "Outbox Pending"
          },
          "outbox_published": {
            "type": "integer",
            "title": "Outbox Published"
          },
          "outbox_failing": {
            "type": "integer",
            "title": "Outbox Failing"
          },
          "inbox_processed": {
            "type": "integer",
            "title": "Inbox Processed"
          },
          "by_type": {
            "items": {
              "$ref": "#/components/schemas/EventTypeCount"
            },
            "type": "array",
            "title": "By Type"
          },
          "recent": {
            "items": {
              "$ref": "#/components/schemas/RecentEvent"
            },
            "type": "array",
            "title": "Recent"
          }
        },
        "type": "object",
        "required": [
          "service",
          "outbox_pending",
          "outbox_published",
          "outbox_failing",
          "inbox_processed",
          "by_type",
          "recent"
        ],
        "title": "OpsEvents"
      },
      "Organization": {
        "properties": {
          "organization_id": {
            "type": "string",
            "title": "Organization Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "newsroom",
              "agency"
            ],
            "title": "Kind"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "region": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_dns",
              "verified",
              "rejected"
            ],
            "title": "Status"
          },
          "txt_record": {
            "type": "string",
            "title": "Txt Record",
            "description": "The TXT value to publish on the domain"
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified At"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "organization_id",
          "name",
          "kind",
          "domain",
          "region",
          "status",
          "txt_record",
          "verified_at",
          "synthetic",
          "created_at"
        ],
        "title": "Organization"
      },
      "OrganizationIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 2,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "newsroom",
              "agency"
            ],
            "title": "Kind"
          },
          "domain": {
            "type": "string",
            "title": "Domain",
            "description": "The organization's own domain, e.g. redaksi.example.org"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          }
        },
        "type": "object",
        "required": [
          "name",
          "kind",
          "domain",
          "region"
        ],
        "title": "OrganizationIn"
      },
      "ProbeResult": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "published": {
            "type": "integer",
            "title": "Published"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "decision_id",
          "published"
        ],
        "title": "ProbeResult"
      },
      "QuorumStatus": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "pending"
            ],
            "title": "Outcome"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "approvals": {
            "type": "integer",
            "title": "Approvals"
          },
          "rejections": {
            "type": "integer",
            "title": "Rejections"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "reason",
          "approvals",
          "rejections"
        ],
        "title": "QuorumStatus"
      },
      "Readiness": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status"
          },
          "release": {
            "type": "string",
            "title": "Release"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "outbox_pending": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outbox Pending"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "service",
          "status",
          "release",
          "environment",
          "demo_mode",
          "database"
        ],
        "title": "Readiness"
      },
      "RecentEvent": {
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "out",
              "in"
            ],
            "title": "Direction"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "pending",
              "failing",
              "processed"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "direction",
          "event_type",
          "at",
          "status"
        ],
        "title": "RecentEvent"
      },
      "Region": {
        "properties": {
          "regency_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regency Code"
          },
