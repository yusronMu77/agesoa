# Local run (copy to .env, gitignored). Database URL: agesoa-devenv/outputs/local-endpoints.env
# (DATABASE_URL_INGESTION, with the scheme changed to postgresql+asyncpg://).
ENVIRONMENT=local
DEMO_MODE=false
DATABASE_URL=postgresql+asyncpg://ingestion:CHANGE_ME@10.90.102.204:5432/ingestion
GOOGLE_CLOUD_PROJECT=agesoa-local
PUBSUB_EMULATOR_HOST=10.90.102.204:8085
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Agen Intake model: `rules` (rule-based fallback, narrative only; local or demo_mode) or a Gemini model id
# (needs GOOGLE_API_KEY, or GOOGLE_GENAI_USE_VERTEXAI=true + Vertex credentials).
INTAKE_MODEL=rules
# Evidence media: unset = services/ingestion/.media (local); GCS bucket name elsewhere.
# MEDIA_BUCKET=
# DEMO_MODE=true also loads the fictional Kabupaten Sukamaju districts (regions/) used by the demo scenarios.
