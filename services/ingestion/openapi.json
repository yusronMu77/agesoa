{
  "openapi": "3.1.0",
  "info": {
    "title": "AGESOA ingestion",
    "description": "Citizen reports (drafts, corrections, media, privacy guard) and public signals; agents Intake and Signal.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness (no dependencies)",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: own database reachable",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/internal/outbox/sweep": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Publish outbox events left behind (Cloud Scheduler, every minute)",
        "operationId": "sweep_internal_outbox_sweep_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SweepResult"
                }
              }
            }
          }
        }
      }
    },
    "/internal/probe": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Record a system probe decision through the outbox (end-to-end event path check)",
        "operationId": "probe_internal_probe_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domain-packs": {
      "get": {
        "tags": [
          "domain packs"
        ],
        "summary": "Domain packs loaded by the core engine",
        "operationId": "list_packs_v1_domain_packs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DomainPackSummary"
                  },
                  "type": "array",
                  "title": "Response List Packs V1 Domain Packs Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domain-packs/{pack_id}": {
      "get": {
        "tags": [
          "domain packs"
        ],
        "summary": "Full pack document (categories, report fields, rules, cause framework, ...)",
        "operationId": "get_pack_v1_domain_packs__pack_id__get",
        "parameters": [
          {
            "name": "pack_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pack Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Pack V1 Domain Packs  Pack Id  Get"
                }
              }
            }
          },
          "404": {
            "description": "Unknown pack"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domain-packs/{pack_id}/evaluate": {
      "post": {
        "tags": [
          "domain packs"
        ],
        "summary": "Evaluate the pack's rules and evidence deadline for a set of report fields",
        "operationId": "evaluate_v1_domain_packs__pack_id__evaluate_post",
        "parameters": [
          {
            "name": "pack_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pack Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown pack"
          },
          "422": {
            "description": "Invalid fields (e.g. datetime without offset)"
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/regions/districts": {
      "get": {
        "tags": [
          "reports",
          "regions"
        ],
        "summary": "Districts for manual selection",
        "operationId": "list_districts_v1_regions_districts_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DistrictOut"
                  },
                  "type": "array",
                  "title": "Response List Districts V1 Regions Districts Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/regions/resolve": {
      "post": {
        "tags": [
          "reports",
          "regions"
        ],
        "summary": "Approximate position -> district (the position is not stored or logged)",
        "operationId": "resolve_district_v1_regions_resolve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Coordinates"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DistrictOut"
                }
              }
            }
          },
          "404": {
            "description": "Outside every known district; pick one by hand"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/reports": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Start a report draft (anonymous)",
        "operationId": "create_report_v1_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/reports/{report_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Read one of my reports",
        "operationId": "get_report_v1_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "description": "No such report for this reporter"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "reports"
        ],
        "summary": "Correct a draft",
        "operationId": "patch_report_v1_reports__report_id__patch",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "description": "No such report for this reporter"
          },
          "409": {
            "description": "The report was already submitted"
          },
          "422": {
            "description": "Unknown category/field or wrong value type"
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/reports/{report_id}/evidence": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Upload one evidence file (photo, screenshot or voice note); metadata is removed before storage",
        "operationId": "upload_evidence_v1_reports__report_id__evidence_post",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_evidence_v1_reports__report_id__evidence_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceOut"
                }
              }
            }
          },
          "404": {
            "description": "No such report for this reporter"
          },
          "409": {
            "description": "The report was already submitted"
          },
          "413": {
            "description": "File larger than 20 MB"
          },
          "415": {
            "description": "Not an accepted image/audio format"
          },
          "422": {
            "description": "More than 10 files"
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/reports/{report_id}/evidence/{evidence_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Download one of my stored evidence files (as stored: after metadata removal)",
        "operationId": "download_evidence_v1_reports__report_id__evidence__evidence_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          },
          {
            "name": "evidence_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Evidence Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {}
            }
          },
          "404": {
            "description": "No such report for this reporter"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports/{report_id}/intake": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Run Agen Intake on the narrative and evidence; fills the draft (AI result, to be corrected)",
        "operationId": "run_intake_v1_reports__report_id__intake_post",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "description": "No such report for this reporter"
          },
          "409": {
            "description": "The report was already submitted"
          },
          "503": {
            "description": "Agen Intake is unavailable; fill the draft by hand"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports/{report_id}/submit": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Confirm the draft; publishes laporan.diterima and a decision-log entry",
        "operationId": "submit_report_v1_reports__report_id__submit_post",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "404": {
            "description": "No such report for this reporter"
          },
          "409": {
            "description": "The report was already submitted"
          },
          "422": {
            "description": "No category yet, or nothing to report (no narrative and no evidence)"
          }
        }
      }
    },
    "/v1/demo/scenarios": {
      "get": {
        "tags": [
          "demo"
        ],
        "summary": "Synthetic scenarios (demo_mode only)",
        "operationId": "list_scenarios_v1_demo_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScenarioSummary"
                  },
                  "type": "array",
                  "title": "Response List Scenarios V1 Demo Scenarios Get"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned for every route when demo_mode is off)"
          }
        }
      }
    },
    "/v1/demo/scenarios/{scenario_id}": {
      "get": {
        "tags": [
          "demo"
        ],
        "summary": "One synthetic scenario without its answer key (demo_mode only)",
        "operationId": "get_scenario_v1_demo_scenarios__scenario_id__get",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Scenario V1 Demo Scenarios  Scenario Id  Get"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned for every route when demo_mode is off)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_evidence_v1_reports__report_id__evidence_post": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "audio",
              "screenshot"
            ],
            "title": "Kind"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "The file; its declared content type is not trusted"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "file"
        ],
        "title": "Body_upload_evidence_v1_reports__report_id__evidence_post"
      },
      "Coordinates": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "Coordinates"
      },
      "DatabaseStatus": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "DatabaseStatus"
      },
      "DistrictOut": {
        "properties": {
          "regency_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regency Code"
          },
          "regency_name": {
            "type": "string",
            "title": "Regency Name"
          },
          "district_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District Code"
          },
          "district_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District Name"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          }
        },
        "type": "object",
        "required": [
          "regency_name",
          "synthetic"
        ],
        "title": "DistrictOut"
      },
      "DomainPackSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "name": {
            "$ref": "#/components/schemas/Label"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "rules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rules"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version",
          "name",
          "categories",
          "rules"
        ],
        "title": "DomainPackSummary"
      },
      "EvaluateRequest": {
        "properties": {
          "fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Fields",
            "description": "Report fields keyed by the pack's report_fields ids; datetimes in ISO 8601 with offset"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "type": "object",
        "required": [
          "fields",
          "received_at"
        ],
        "title": "EvaluateRequest"
      },
      "EvaluateResponse": {
        "properties": {
          "rule_results": {
            "items": {
              "$ref": "#/components/schemas/RuleResultOut"
            },
            "type": "array",
            "title": "Rule Results"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceStatusOut"
          },
          "evidence_tips": {
            "items": {
              "$ref": "#/components/schemas/Label"
            },
            "type": "array",
            "title": "Evidence Tips",
            "description": "Shown to the reporter while physical evidence is still available"
          },
          "missing_required": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Required"
          }
        },
        "type": "object",
        "required": [
          "rule_results",
          "evidence",
          "evidence_tips",
          "missing_required"
        ],
        "title": "EvaluateResponse"
      },
      "EvidenceOut": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "audio",
              "screenshot"
            ],
            "title": "Kind"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256",
            "description": "SHA-256 of the stored file (after metadata removal)"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "metadata_removed": {
            "type": "boolean",
            "title": "Metadata Removed"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "media_type",
          "sha256",
          "size_bytes",
          "metadata_removed"
        ],
        "title": "EvidenceOut"
      },
      "EvidenceStatusOut": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "likely_lost",
              "unknown"
            ],
            "title": "Status"
          },
          "deadline_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "max_finding_status": {
            "type": "string",
            "enum": [
              "alleged",
              "supported",
              "proven"
            ],
            "title": "Max Finding Status"
          }
        },
        "type": "object",
        "required": [
          "status",
          "deadline_at",
          "max_finding_status"
        ],
