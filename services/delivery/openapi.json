{
  "openapi": "3.1.0",
  "info": {
    "title": "AGESOA delivery",
    "description": "Audit reports, institution subscriptions with signed webhooks, status and right-of-reply API; agent Report.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Liveness (no dependencies)",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readiness: own database reachable",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    },
    "/internal/outbox/sweep": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Publish outbox events left behind (Cloud Scheduler, every minute)",
        "operationId": "sweep_internal_outbox_sweep_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SweepResult"
                }
              }
            }
          }
        }
      }
    },
    "/internal/demo/reset": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Empty this service's database and seed its demo data again (demo_mode only)",
        "operationId": "demo_reset_internal_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned when demo_mode is off)"
          }
        }
      }
    },
    "/internal/probe": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Record a system probe decision through the outbox (end-to-end event path check)",
        "operationId": "probe_internal_probe_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ops/events": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Event traffic of this service (operator; counts and types, no payloads)",
        "operationId": "events_v1_ops_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsEvents"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ops/demo-reset": {
      "post": {
        "tags": [
          "ops"
        ],
        "summary": "Operator: empty this service's database and seed its demo data again (demo_mode only)",
        "operationId": "operator_demo_reset_v1_ops_demo_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned when demo_mode is off)"
          }
        }
      }
    },
    "/v1/cases/{case_id}/audit-report": {
      "get": {
        "tags": [
          "audit reports"
        ],
        "summary": "Audit report of a case (public once the finding is validated)",
        "operationId": "get_audit_report_v1_cases__case_id__audit_report_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditReport"
                }
              }
            }
          },
          "404": {
            "description": "No audit report for this case yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions/mine": {
      "get": {
        "tags": [
          "institutions"
        ],
        "summary": "Verified organizations administered by the caller",
        "operationId": "my_institutions_v1_institutions_mine_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Institution"
                  },
                  "type": "array",
                  "title": "Response My Institutions V1 Institutions Mine Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions/{organization_id}": {
      "get": {
        "tags": [
          "institutions"
        ],
        "summary": "Agency dashboard (SCR-062)",
        "operationId": "get_institution_v1_institutions__organization_id__get",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Institution"
                }
              }
            }
          },
          "404": {
            "description": "No verified agency with this id administered by the caller"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions/{organization_id}/subscription": {
      "put": {
        "tags": [
          "institutions"
        ],
        "summary": "Subscribe a webhook (replaces the current one); the HMAC secret is returned only here",
        "operationId": "subscribe_v1_institutions__organization_id__subscription_put",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionCreated"
                }
              }
            }
          },
          "404": {
            "description": "No verified agency with this id administered by the caller"
          },
          "422": {
            "description": "Invalid URL (https required outside local)"
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/v1/institutions/{organization_id}/api-key": {
      "post": {
        "tags": [
          "institutions"
        ],
        "summary": "Create the institution API key (replaces the previous one); returned only here",
        "operationId": "create_api_key_v1_institutions__organization_id__api_key_post",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyCreated"
                }
              }
            }
          },
          "404": {
            "description": "No verified agency with this id administered by the caller"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions/{organization_id}/test-event": {
      "post": {
        "tags": [
          "institutions"
        ],
        "summary": "Send a test_event to the subscribed webhook",
        "operationId": "send_test_event_v1_institutions__organization_id__test_event_post",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestEventQueued"
                }
              }
            }
          },
          "404": {
            "description": "No verified agency with this id administered by the caller"
          },
          "409": {
            "description": "No active webhook subscription"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions/{organization_id}/deliveries": {
      "get": {
        "tags": [
          "institutions"
        ],
        "summary": "Webhook delivery history, newest first, with every attempt",
        "operationId": "delivery_history_v1_institutions__organization_id__deliveries_get",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Organization Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Delivery"
                  },
                  "title": "Response Delivery History V1 Institutions  Organization Id  Deliveries Get"
                }
              }
            }
          },
          "404": {
            "description": "No verified agency with this id administered by the caller"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cases/{case_id}/status": {
      "post": {
        "tags": [
          "institution API"
        ],
        "summary": "Institution updates the follow-up status of a case",
        "operationId": "update_status_api_v1_cases__case_id__status_post",
        "security": [
          {
            "InstitutionApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid institution API key"
          },
          "404": {
            "description": "No audit report of this case was delivered to this institution"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/api/v1/cases/{case_id}/reply": {
      "post": {
        "tags": [
          "institution API"
        ],
        "summary": "Institution submits a right of reply (shown labelled next to the finding)",
        "operationId": "submit_reply_api_v1_cases__case_id__reply_post",
        "security": [
          {
            "InstitutionApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reply"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid institution API key"
          },
          "404": {
            "description": "No audit report of this case was delivered to this institution"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    },
    "/internal/webhooks/{delivery_id}/attempts/{number}": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Run one webhook attempt (called by Cloud Tasks)",
        "operationId": "run_attempt_internal_webhooks__delivery_id__attempts__number__post",
        "parameters": [
          {
            "name": "delivery_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Delivery Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/demo/audit-reports": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Create a fictional audit report and deliver it (demo_mode only, until the Report agent exists)",
        "operationId": "demo_audit_report_internal_demo_audit_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoAuditReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoReportCreated"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also when demo_mode is off)"
          },
          "409": {
            "description": "Exists"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body (not valid JSON)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "received_at"
        ],
        "title": "Accepted"
      },
      "ApiKeyCreated": {
        "properties": {
          "api_key": {
            "type": "string",
            "title": "Api Key",
            "description": "Shown only once; only its hash is stored"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "api_key",
          "prefix",
          "created_at"
        ],
        "title": "ApiKeyCreated"
      },
      "ApiKeyView": {
        "properties": {
          "prefix": {
            "type": "string",
            "title": "Prefix"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "prefix",
          "created_at"
        ],
        "title": "ApiKeyView"
      },
      "Attachment": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "title": "Name"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "title": "Attachment"
      },
      "AttemptResult": {
        "properties": {
          "result": {
            "type": "string",
            "title": "Result"
          }
        },
        "type": "object",
        "required": [
          "result"
        ],
        "title": "AttemptResult"
      },
      "AuditReport": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "root_causes": {
            "items": {
              "$ref": "#/components/schemas/RootCause"
            },
            "type": "array",
            "title": "Root Causes"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "region": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "case_id",
          "domain",
          "summary",
          "root_causes",
          "recommendations",
          "region",
          "category",
          "synthetic",
          "created_at"
        ],
        "title": "AuditReport"
      },
      "DatabaseStatus": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "ok"
        ],
        "title": "DatabaseStatus"
      },
      "Delivery": {
        "properties": {
          "delivery_id": {
            "type": "string",
            "title": "Delivery Id"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "event": {
            "type": "string",
            "enum": [
              "audit_report.final",
              "test_event"
            ],
            "title": "Event"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "failed"
            ],
            "title": "Status"
          },
          "internal_ticket": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Internal Ticket"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/DeliveryAttempt"
            },
            "type": "array",
            "title": "Attempts"
          }
        },
        "type": "object",
        "required": [
          "delivery_id",
          "event_id",
          "event",
          "case_id",
          "status",
          "internal_ticket",
          "created_at",
          "attempts"
        ],
        "title": "Delivery"
      },
      "DeliveryAttempt": {
        "properties": {
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "http_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Http Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "attempted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Attempted At"
          }
        },
        "type": "object",
        "required": [
          "attempt",
          "http_status",
          "error",
          "attempted_at"
        ],
        "title": "DeliveryAttempt"
